<?xml version="1.0" encoding="utf-8"?>
<!-- a splash até o Android 11: o marinho da marca com o símbolo branco no
     centro, do mesmo tamanho da splash do Flutter, que continua sem salto -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/marinho" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_marca" />
    </item>
</layer-list>
