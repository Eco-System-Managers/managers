# Copie para .env no desenvolvimento local. Em produção (Railway), cada linha
# vira uma variável do serviço — os valores de exemplo de produção estão nos
# comentários.

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Em produção, nunca troque depois de no ar: as chaves dos tokens derivam dela.
SECRET_KEY=
DEBUG=True
# Produção: api.workmanage.com.br
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Produção: True e 1 (o proxy do Railway fica na frente)
HTTPS=False
NUM_PROXIES=0

# --- Banco (Railway: ${{Postgres.PGDATABASE}}, PGUSER, PGPASSWORD, PGHOST, PGPORT) ---
DB_NAME=workmanage
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cache (Railway: ${{Redis.REDIS_URL}}). Vazio = memória do processo ---
REDIS_URL=

# --- Links e domínios ---
# Base dos links de convite, contrato e volta do checkout. Produção: https://api.workmanage.com.br
LINKS_BASE_URL=http://localhost:8000
# Sufixo dos domínios de tenant. NUNCA o domínio da API nem um pai dele: uma
# empresa chamada "Api" ganharia api.<sufixo>, e toda requisição a esse host
# cairia no schema dela. Produção: tenants.workmanage.com.br
TENANT_DOMAIN_SUFFIX=localhost

# --- E-mail ---
# Produção: chave do Resend (o Railway bloqueia SMTP nos planos Trial e Hobby).
# Vazio, cai no SMTP abaixo; sem SMTP, o e-mail sai no terminal.
RESEND_API_KEY=
# Produção: Work Manage <noreply@workmanage.com.br> (domínio verificado no Resend)
DEFAULT_FROM_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Arquivos (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1

# --- Mercado Pago (credenciais de produção no deploy) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Domínio da API, com https (o retorno do checkout passa por ela).
# Produção: https://api.workmanage.com.br
MERCADOPAGO_BACK_URL=
