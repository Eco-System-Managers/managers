# Django
# Obrigatória: a aplicação não sobe sem ela
SECRET_KEY=django-insecure-troque-em-producao
# Opcionais: chaves JWT por produto. Sem elas, são derivadas da SECRET_KEY
# JWT_SIGNING_KEY_B2B=
# JWT_SIGNING_KEY_B2C=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Banco de dados
DB_NAME=workmanage
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# HTTPS (produção): liga redirect, HSTS e cookies Secure. Deixe False em local
HTTPS=False
# SECURE_HSTS_SECONDS=3600

# Billing: gateway das assinaturas e plano usado no trial e no checkout
BILLING_GATEWAY=mercadopago
PLANO_PADRAO=pro

# Rate limiting
# Proxies confiáveis na frente da API (0 = sem proxy; usa o IP da conexão)
NUM_PROXIES=0
# Opcional: com ela, cache e contadores ficam no Redis (ex.: redis://localhost:6379/0)
# REDIS_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Mercado Pago API
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail (SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AWS S3 — midia
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=marques894-managers-midia-dev
AWS_S3_REGION_NAME=sa-east-1